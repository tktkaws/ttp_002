---
import { identity } from "../data/portfolio";
import FixedNav from "./FixedNav.astro";
import PreferenceToggles from "./PreferenceToggles.astro";
import type { NavItem } from "../types/portfolio";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<header>
  <h1
    class="logo-random-reveal text-logo font-zen header_logo w-fit pb-16 2xl:pb-32"
    data-logo-random-reveal
    aria-label={identity.logoLabel}
  >
    <span aria-hidden="true">
      {identity.logoLines.map((line, index) => (
        <Fragment>
          {Array.from(line).map((character) => (
            <span data-logo-char data-reveal-text={character}>
              {character}
            </span>
          ))}
          {index < identity.logoLines.length - 1 && <br />}
        </Fragment>
      ))}
    </span>
  </h1>
  <PreferenceToggles />
  <FixedNav items={items} />
</header>

<script>
  import { initLogoReveal } from "../scripts/logo-reveal";
  initLogoReveal();
</script>

<style>
  header {
    position: relative;
  }

  [data-logo-char] {
    position: relative;
    display: inline-block;
    opacity: 1;
  }
</style>
