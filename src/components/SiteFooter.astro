---
import { identity } from "../data/portfolio";
import type { NavItem } from "../types/portfolio";

interface Props {
  items: NavItem[];
}
const { items: navItems } = Astro.props;
---

<footer
  id="site-footer"
  class="border-t border-gray-900 pt-[8rem] mt-[8rem] dark:border-gray-100"
>
  <div class="flex flex-col items-start gap-[6rem] sm:flex-row sm:items-start sm:justify-between">
    <p class="text-logo font-zen header_logo">
      {identity.logoLines.map((line, index) => (
        <Fragment>
          {line}
          {index < identity.logoLines.length - 1 && <br />}
        </Fragment>
      ))}
    </p>
    <nav
      aria-label="フッターナビゲーション"
      class="text-body w-fit bg-white text-left font-sans font-light text-gray-900 dark:bg-gray-900 dark:text-gray-100 sm:text-right"
    >
      <ul class="grid gap-2 lg:p-4 pt-0">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mt-16 flex items-center justify-end gap-3 text-right font-sans font-light">
    <p class="text-caption">Developed by</p>
    <a
      href={identity.githubUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-current">
        <path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0 1 12 7c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.95.68 1.92 0 1.38-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z"></path>
      </svg>
    </a>
  </div>
</footer>
