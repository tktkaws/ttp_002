---
import type { NavItem } from "../types/portfolio";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav id="fixed-nav" aria-label="表示設定とページ内ナビゲーション" class="fixed-nav font-sans font-normal">
  <ul class="fixed-nav__items">
    <li>
      <details class="fixed-nav__item" data-preference-item hidden>
        <summary class="fixed-nav__trigger">
          Animation:<span data-animation-label>Off</span>
        </summary>
        <ul id="animation-options" class="fixed-nav__panel">
          <li><button type="button" data-animation="off" aria-pressed="true" disabled>Off</button></li>
          <li><button type="button" data-animation="on" aria-pressed="false" disabled>On</button></li>
        </ul>
      </details>
    </li>
    <li>
      <details class="fixed-nav__item" data-preference-item hidden>
        <summary class="fixed-nav__trigger">
          Theme:<span data-theme-label>Light</span>
        </summary>
        <ul id="theme-options" class="fixed-nav__panel">
          <li><button type="button" data-theme="light" aria-pressed="true" disabled>Light</button></li>
          <li><button type="button" data-theme="dark" aria-pressed="false" disabled>Dark</button></li>
        </ul>
      </details>
    </li>
    <li>
      <details class="fixed-nav__item" data-contents-item open>
        <summary class="fixed-nav__trigger">
          Contents
        </summary>
        <ul id="contents-options" class="fixed-nav__panel">
          {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </details>
    </li>
  </ul>
</nav>

<script>
  import { initFixedNav } from "../scripts/fixed-nav";
  initFixedNav();
</script>

<style>
  .fixed-nav [hidden] { display: none; }

  .fixed-nav:not([data-enhanced]) {
    position: static;
    margin-bottom: 2rem;
  }

  .fixed-nav:not([data-enhanced]) .fixed-nav__items { display: block; }

  .fixed-nav:not([data-enhanced]) .fixed-nav__panel {
    position: static;
    margin: 0;
    padding: 0;
    border: 0;
    max-height: none;
    background: transparent;
  }

  .fixed-nav {
    position: fixed;
    z-index: 50;
    top: var(--header-offset);
    right: var(--body-padding);
    max-width: calc(100% - 2 * var(--body-padding));
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.5;
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .fixed-nav--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .fixed-nav:focus-within {
    opacity: 1;
    pointer-events: auto;
  }

  .fixed-nav__items {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .fixed-nav__item {
    position: relative;
    text-align: right;
  }

  .fixed-nav__trigger {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    cursor: pointer;
    padding-inline: 0.2em;
    list-style: none;
  }

  .fixed-nav__trigger::-webkit-details-marker { display: none; }

  .fixed-nav__trigger:is(:focus-visible, :hover) {
    outline: var(--focus-ring-width) solid var(--focus-ring-outer);
    outline-offset: var(--focus-ring-offset);
    background: var(--focus-ring-inner);
    box-shadow: 0 0 0 var(--focus-ring-inner-width) var(--focus-ring-inner);
  }

  :global(html:not(.dark)) .fixed-nav__trigger:is(:focus-visible, :hover) { color: var(--focus-ring-text); }

  .fixed-nav__panel {
    position: absolute;
    top: 100%;
    right: 0;
    width: max-content;
    min-width: 100%;
    max-width: calc(100vw - 2 * var(--body-padding));
    max-height: max(6rem, calc(100dvh - var(--header-offset) - 10rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 0.5rem;
    padding: 0.5rem;
    border: 1px solid currentColor;
    background: var(--color-white);
  }

  :global(html.dark) .fixed-nav__panel {
    background: var(--color-gray-900);
  }

  .fixed-nav__panel li {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 44px;
  }

  .fixed-nav__panel :is(button, a) {
    display: inline;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
    cursor: pointer;
  }

  .fixed-nav__panel button[aria-pressed="true"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 768px) {
    .fixed-nav__items {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
    }

    .fixed-nav__panel {
      position: static;
      margin-block: 0.25rem 0.5rem;
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fixed-nav {
      transition: none;
    }
  }

  /* Keep every option reachable when zoom leaves little screen space. */
  @media (max-width: 639px), (max-height: 480px) {
    .fixed-nav {
      position: static;
      max-width: 100%;
      margin-bottom: 2rem;
      opacity: 1;
      pointer-events: auto;
    }

    .fixed-nav__panel {
      position: static;
      max-height: none;
    }
  }
</style>
