---
import type { NavItem } from "../types/portfolio";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav
  id="fixed-nav"
  aria-label="ページ内ナビゲーション"
  class="fixed-nav font-sans font-normal"
>
  <button
    type="button"
    class="fixed-nav__menu-button"
    data-menu-button
    popovertarget="fixed-nav-popover"
    aria-controls="fixed-nav-popover"
    aria-label="コンテンツメニュー"
  >
    <span class="fixed-nav__lines" aria-hidden="true">
      {items.map((item) => (
        <span class="fixed-nav__line" data-section-line={item.href} />
      ))}
    </span>
  </button>
  <div
    id="fixed-nav-popover"
    class="fixed-nav__popover"
    popover="auto"
    data-contents-item
  >
    <ul id="contents-options">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  import { initFixedNav } from "../scripts/fixed-nav";
  initFixedNav();
</script>

<style>
  .fixed-nav {
    position: fixed;
    z-index: 50;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .fixed-nav__menu-button {
    display: grid;
    place-items: center;
    width: 44px;
    min-height: 44px;
    padding: 12px 8px;
    cursor: pointer;
  }

  .fixed-nav__lines {
    display: grid;
    justify-items: end;
    align-items: center;
    grid-auto-rows: 18px;
  }

  .fixed-nav__line {
    width: 20px;
    height: 2px;
    border-radius: 0;
    background: #b4b4b4;
  }

  .fixed-nav__line[data-current] {
    width: 28px;
    height: 4px;
    background: #000;
  }

  @media (width < 640px) {
    .fixed-nav__lines {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
    }

    .fixed-nav__line {
      width: calc(var(--body-padding) - 8px);
    }

    .fixed-nav__line[data-current] {
      width: var(--body-padding);
    }
  }

  .fixed-nav__popover {
    position: fixed;
    inset: 50% 44px auto auto;
    translate: 0 -50%;
    margin: 0;
    width: 14.4rem;
    max-width: calc((100vw - 60px) * 0.8);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    border: 1px solid #e5e5e5;
    border-radius: 0;
    background: #fff;
    color: #525252;
    box-shadow: 0 12px 32px rgb(0 0 0 / 8%);
  }

  #contents-options {
    display: grid;
    gap: 0.25rem;
  }

  #contents-options a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem;
    overflow-wrap: anywhere;
  }

  #contents-options a[aria-current="location"] {
    color: #000;
    font-weight: 700;
  }

  :global(html.dark) .fixed-nav__line {
    background: #6b7280;
  }

  :global(html.dark) .fixed-nav__line[data-current] {
    background: #fff;
  }

  :global(html.dark) .fixed-nav__popover {
    background: var(--color-gray-900);
    color: var(--color-gray-300);
    border-color: var(--color-gray-700);
  }

  :global(html.dark) #contents-options a[aria-current="location"] {
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fixed-nav__popover:popover-open {
      animation: menu-slide-in 180ms ease-out;
    }
  }

  @keyframes menu-slide-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (forced-colors: active) {
    .fixed-nav__line {
      background: GrayText;
    }
    .fixed-nav__line[data-current] {
      background: CanvasText;
    }
  }
</style>
