---
import type { NavItem } from "../types/portfolio";

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav id="fixed-nav" aria-label="表示設定とページ内ナビゲーション" class="fixed-nav font-sans font-normal">
  <ul class="fixed-nav__items">
    <li class="fixed-nav__item">
      <button type="button" class="fixed-nav__trigger" aria-expanded="false" aria-controls="animation-options">
        Animation:<span data-animation-label>Off</span>
      </button>
      <ul id="animation-options" class="fixed-nav__panel" hidden>
        <li><button type="button" data-animation="off" aria-pressed="true">Off</button></li>
        <li><button type="button" data-animation="on" aria-pressed="false">On</button></li>
      </ul>
    </li>
    <li class="fixed-nav__item">
      <button type="button" class="fixed-nav__trigger" aria-expanded="false" aria-controls="theme-options">
        Theme:<span data-theme-label>Light</span>
      </button>
      <ul id="theme-options" class="fixed-nav__panel" hidden>
        <li><button type="button" data-theme="light" aria-pressed="true">Light</button></li>
        <li><button type="button" data-theme="dark" aria-pressed="false">Dark</button></li>
      </ul>
    </li>
    <li class="fixed-nav__item">
      <button type="button" class="fixed-nav__trigger" aria-expanded="false" aria-controls="contents-options">
        Contents
      </button>
      <ul id="contents-options" class="fixed-nav__panel" hidden>
        {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </li>
  </ul>
</nav>

<script>
  import "../scripts/fixed-nav";
</script>

<style>
  .fixed-nav {
    position: fixed;
    z-index: 50;
    top: var(--header-offset);
    right: var(--body-padding);
    max-width: calc(100% - 2 * var(--body-padding));
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.5;
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .fixed-nav--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .fixed-nav:focus-within {
    opacity: 1;
    pointer-events: auto;
  }

  .fixed-nav__items {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .fixed-nav__item {
    position: relative;
    text-align: right;
  }

  .fixed-nav__trigger {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  .fixed-nav__panel {
    position: absolute;
    top: 100%;
    right: 0;
    width: max-content;
    min-width: 100%;
    max-width: calc(100vw - 2 * var(--body-padding));
    max-height: max(6rem, calc(100dvh - var(--header-offset) - 10rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 0.5rem;
    padding: 0.5rem;
    border: 1px solid currentColor;
    background: var(--color-white);
  }

  :global(html.dark) .fixed-nav__panel {
    background: var(--color-gray-900);
  }

  .fixed-nav__panel li {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 44px;
  }

  .fixed-nav__panel :is(button, a) {
    display: inline;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
    cursor: pointer;
  }

  .fixed-nav__panel button[aria-pressed="true"] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 768px) {
    .fixed-nav__items {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
    }

    .fixed-nav__panel {
      position: static;
      margin-block: 0.25rem 0.5rem;
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fixed-nav {
      transition: none;
    }
  }
</style>
