---
import { defaultPreferences, preferenceKeys } from "../config/preferences";
---

<!-- Paint the canvas and native controls correctly while external CSS loads. -->
<style is:inline>
  html[data-theme="light"] {
    color-scheme: light;
    background-color: var(--color-white, #fff);
  }
  html[data-theme="dark"] {
    color-scheme: dark;
    background-color: var(--color-gray-900, #111827);
  }
</style>

<!-- Run before external stylesheets, without waiting for a module download. -->
<script is:inline define:vars={{ defaultPreferences, preferenceKeys }}>
  {
    let theme = defaultPreferences.theme;
    let animation = defaultPreferences.animation;
    const read = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const storedTheme = read(preferenceKeys.theme);
    const storedAnimation = read(preferenceKeys.animation);
    if (storedTheme === "light" || storedTheme === "dark") theme = storedTheme;
    if (storedAnimation === "off" || storedAnimation === "on")
      animation = storedAnimation;
    const root = document.documentElement;
    root.classList.toggle("dark", theme === "dark");
    root.dataset.theme = theme;
    root.dataset.animation = animation;
    document
      .querySelector('meta[name="color-scheme"]')
      ?.setAttribute("content", theme);
  }
</script>
