---
export interface TimelineItem {
  year: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
  label?: string;
  color?: string;
  soft?: boolean;
  showControls?: boolean;
  dropDistance?: number;
  dropInterval?: number;
  /** Set a unique key to remember this instance's color/mode in the URL. */
  settingsKey?: string;
}

const LIGHT_CARD_COLORS = new Set([
  "#d8ddd4",
  "#f9d34a",
  "#58cdba",
  "#b2a5f0",
  "#63dcb9",
  "#ee8d8a",
  "#f0eee9",
  "#c2c9cb",
]);

const {
  items,
  label = "タイムライン",
  color = "#4F5A6B",
  soft = false,
  showControls = false,
  dropDistance = 0.25,
  dropInterval = 320,
  settingsKey,
} = Astro.props;

const textColor = LIGHT_CARD_COLORS.has(color.toLowerCase()) ? "#000" : "#fff";
---

<falling-timeline
  style={`--timeline-card-color: ${color}; --timeline-card-text: ${textColor}`}
  data-color={color}
  data-soft={String(soft)}
  data-controls={String(showControls)}
  data-distance={dropDistance}
  data-interval={dropInterval}
  data-settings-key={settingsKey}
>
  <div class="controls" data-controls-container hidden={!showControls}></div>
  <section
    class="timeline"
    data-stage
    aria-label={label}
    hidden={items.length === 0}
  >
    <div class="line" data-line aria-hidden="true"></div>
    <ol class="list">
      {items.map(({ year, description }) => (
        <li class="item">
          <span class="node" data-node aria-hidden="true"></span>
          <article class="card" data-card>
            <h3>{year}</h3>
            <p>{description}</p>
          </article>
        </li>
      ))}
    </ol>
    <span class="end" aria-hidden="true"></span>
    <svg class="skin" data-skin aria-hidden="true" focusable="false"></svg>
  </section>
</falling-timeline>

<style>
  falling-timeline {
    display: block;
    max-width: 960px;
    margin-left: 0;
  }
  falling-timeline,
  falling-timeline * {
    box-sizing: border-box;
  }
  .controls {
    width: min(280px, 100%);
    margin: 0 24px 16px auto;
  }
  .controls[hidden],
  .timeline[hidden] {
    display: none;
  }
  .timeline {
    --axis-gap: 80px;
    position: relative;
    padding: 110px 24px 64px;
  }
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 1px);
    width: 2px;
    background: #c9cecb;
    transform-origin: top center;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 28px;
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--axis-gap) minmax(0, 1fr);
    align-items: center;
  }
  .node {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    position: relative;
    width: 12px;
    height: 12px;
    border: 3px solid #c9cecb;
    border-radius: 50%;
    background: #fff;
  }
  .node::before {
    content: "";
    position: absolute;
    top: 2px;
    right: 9px;
    width: calc(var(--axis-gap) / 2 - 6px);
    height: 1px;
    background: #c9cecb;
  }
  .item:nth-child(even) .node::before {
    right: auto;
    left: 9px;
  }
  .card {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding: 24px 28px;
    color: var(--timeline-card-text, #fff);
    background: var(--timeline-card-color);
    border-radius: 8px;
    transform-origin: center;
  }
  .item:nth-child(even) .card {
    grid-column: 3;
  }
  h3 {
    margin: 0;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.5;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  p {
    margin: 16px 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.8;
    overflow-wrap: anywhere;
    white-space: pre-line;
    font-weight: 300;
  }
  .end {
    position: absolute;
    bottom: 0;
    left: calc(50% - 4px);
    width: 8px;
    height: 8px;
    background: #c9cecb;
    border-radius: 50%;
  }
  .skin {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  falling-timeline[data-active="true"] .card {
    will-change: transform, opacity;
  }
  falling-timeline[data-active="true"][data-mode="soft"] .card {
    background: transparent;
  }
  falling-timeline[data-active="true"][data-mode="soft"] .skin {
    display: block;
  }
  @media (max-width: 639px) {
    .timeline {
      padding: 80px 0 40px;
    }
    .line {
      left: 5px;
    }
    .item {
      grid-template-columns: 12px minmax(0, 1fr);
      column-gap: 20px;
    }
    .node {
      grid-column: 1;
    }
    .node::before,
    .item:nth-child(even) .node::before {
      right: auto;
      left: 9px;
      width: 20px;
    }
    .card,
    .item:nth-child(even) .card {
      grid-column: 2;
    }
    .card {
      padding: 20px;
    }
    .end {
      left: 2px;
    }
  }
  @media (max-width: 600px) {
    .controls {
      margin-right: 0;
    }
    .card {
      padding: 20px 16px;
    }
    p {
      margin-top: 12px;
      line-height: 1.65;
    }
  }
</style>

<script>
  import "../scripts/timeline";
</script>
