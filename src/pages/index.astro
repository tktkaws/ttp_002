---
import "../styles/global.css";
import FixedNav from "../components/FixedNav.astro";
import FadeInTimeline from "../components/FadeInTimeline.astro";
import TextCards from "../components/TextCards.astro";

const navItems = [
  { href: "#section01", label: "プロフィール" },
  { href: "#section02", label: "経歴" },
  { href: "#section03", label: "スキル" },
  { href: "#section04", label: "強み" },
  { href: "#section05", label: "アウトプット" },
];

const history = [
  {
    year: "2011年 - 2017年",
    description: "大学卒業後、飲食店でフリーターをしていました。飲食店の開業を目指していましたが、一生の仕事にする未来が見えず別の道を模索しました。",
  },
  {
    year: "2017年 - 2019年",
    description: "Amazonの倉庫を運営する会社に入社し、作業者（2000人/1日）の出退勤情報・工程配置情報の管理をExcelで行っていました   。VBAを独学し、1日1時間かかる作業を10分に短縮させました。",
  },
  {
    year: "2019年 - 2021年",
    description: "Web系の受託制作会社に入社しましたが、不眠症に陥り早期退職しました。転職に際し、Ruby on RailsでWebアプリを制作しました。",
  },
  {
    year: "2021年 - 2023年",
    description: "社会復帰し、派遣事務職としてカード会社の事務処理を担当していました。元々フロントエンドへの興味が強かったため、Web制作の学習を始めました。",
  },
  {
    year: "2023年 - 現在",
    description: "東京のWeb制作会社に入社し、コーダーとして勤務しています。",
  },
];

const cardColor = "#4F5A6B";

const skills = [
  {
    label: "HTML",
    description: "セマンティックなマークアップを意識し、Web標準に準拠したUIを実装します。制作過程では、Nu Html Checkerやmarkuplintによる検証を適宜行い、品質を担保します。",
    color: "#304C5A",
  },
  {
    label: "CSS",
    description: "業務ではMindBEMdingを意識し、既存プロジェクトのルールに沿ったCSS設計・実装を行っています。個人開発ではTailwind CSSをよく使用しており、ユーティリティファーストな開発にも対応できます。",
    color: "#59695C",
  },
  {
    label: "JavaScript",
    description: "業務では、アニメーションなどの演出を実装するためのVanilla JavaScriptの記述や、既存ライブラリの導入・調整を主に行っています。個人開発では、TypeScript、React、Next.js、Astroを学びながら実装に取り組んでいます。",
    color: "#896D62",
  },
  {
    label: "WordPress",
    description: "業務では、クラシックエディタとAdvanced Custom Fieldsを用いたテーマ開発を多く経験しています。また、セキュリティに配慮した実装を心がけています。",
    color: "#43695B",
  },
  {
    label: "Accessibility",
    description: "JIS X 8341-3:2016への適合を目指す既存サイトの改修を担当しました。日々の案件でも、可能な限りWCAG 2.2に沿った実装を心がけています。また、DHS Trusted Tester認定を取得し、WCAG 2.0に基づいたWebアクセシビリティ試験を実施できます。",
    color: "#827049",
  },
  {
    label: "Git",
    description: "基本的なGit操作に加え、GitHub Flowによるブランチ運用を理解しています。変更内容が追いやすいコミットを意識し、ブランチの作成からプルリクエスト、レビュー、マージまで、チーム開発の流れに沿って作業できます。",
    color: "#543A3B",
  },
];

const outputs = [
  {
    label: "技術ブログ",
    description:
      "microCMS、Astroを使用しブログを作成しました。Swupによる擬似的な非同期遷移も実装しました。",
    color: cardColor,
    image: "/front-dispatch-2026.vercel.app_.png",
    href: "https://front-dispatch-2026.vercel.app/",
  },
  {
    label: "会議室予約システム",
    description:
      "Next.jsとSupabaseを使用して会議室予約アプリを作成しました。",
    color: cardColor,
    image: "/reservation-01.vercel.app_.png",
    href: "https://reservation-01.vercel.app/",
  },
];
---

<html lang="ja" data-theme="light" data-animation="off">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@latest/cdn/300.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@latest/cdn/400.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@latest/cdn/500.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/gen-interface-jp@latest/cdn/700.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <title>タカハシタカユキのポートフォリオ</title>
    <meta
      name="description"
      content="東京都在住のフロントエンドエンジニア、タカハシタカユキのポートフォリオ。WordPressを中心としたサイト制作の経歴・強み・アウトプットを紹介しています。"
    />
    <script is:inline>
      {
        let theme = "light";
        let animation = "off";
        try {
          theme = localStorage.getItem("theme") === "dark" ? "dark" : "light";
          animation = localStorage.getItem("animation") === "on" ? "on" : "off";
        } catch {
          // Use the defaults when browser storage is unavailable.
        }
        document.documentElement.classList.toggle("dark", theme === "dark");
        document
          .querySelector('meta[name="color-scheme"]')
          ?.setAttribute("content", theme);
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.animation = animation;
      }
    </script>
  </head>
  <body
    class="relative font-sans px-6 pt-12 pb-6 sm:p-12 md:p-16 2xl:p-32 bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
  >
    <FixedNav items={navItems} />
    <h1
      class="text-logo font-zen header_logo w-fit pb-6 sm:pb-12 md:pb-16 2xl:pb-32"
    >
	タカハシ<br />
        タカユキ<br />
        のポート<br />
        フォリオ
    </h1>
    <main>
      <section id="section01" class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]">
		<hgroup>
			<p class="section-number text-body mt-[0.5em]">[01]</p>
			<h2 class="text-display section-inset-x mt-[4rem]">プロフィール</h2>
		</hgroup>
        <div class="section-inset-x mt-[4rem]">
          <div class="text-body font-sans font-light">
            <p>
              はじめまして。タカハシタカユキと申します。<br />
              都内のWeb制作会社で、コーダーとして勤務しています。<br />
              1986年生まれですが、業務歴は3年弱です。<br />
              主に静的サイトの制作保守やWordPressの構築を担当しています。<br />
              Webアクセシビリティとモダンフロントエンドに興味があり、日々学習しています。
            </p>
          </div>
        </div>
      </section>
      <section id="section02" class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]">
		<hgroup>
			<p class="section-number text-body mt-[0.5em]">[02]</p>
			<h2 class="text-display section-inset-x mt-[4rem]">経歴</h2>
		</hgroup>
        <div class="section-inset-x mt-[4rem]">
          <FadeInTimeline items={history} label="2011年から現在までの経歴" color={cardColor} />
        </div>
      </section>
      <section id="section03" class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]">
		<hgroup>
			<p class="section-number text-body mt-[0.5em]">[03]</p>
			<h2 class="text-display section-inset-x mt-[4rem]">スキル</h2>
		</hgroup>
        <div class="section-inset-x mt-[4rem]">
          <TextCards items={skills} label="スキル一覧" />
        </div>
      </section>
      <section id="section04" class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]">
		<hgroup>
			<p class="section-number text-body mt-[0.5em]">[04]</p>
			<h2 class="text-display section-inset-x mt-[4rem]">強み</h2>
		</hgroup>
        <div class="section-inset-x mt-[4rem]">
          <div class="text-body font-sans font-light grid max-w-[1600px] gap-12 xl:grid-cols-2 xl:gap-x-12 xl:gap-y-0">
            <section>
              <h3 class="text-body font-medium">知的好奇心</h3>
              <p class="mt-4">
                有料無料問わずWebアクセシビリティ関連イベントに積極的に参加しています。<br />
                毎日AIが記事を書いてもらい、学んだ内容をナレッジベースに蓄積しています。理解度の確認のため、学んだ内容を自分の言葉でアウトプットすることを心がけています。<br />
                また、気になったUIをAIで再現しコードを解析することで、実装の理解を深める活動も行っています。
              </p>
            </section>
            <section>
              <h3 class="text-body font-medium">主体性</h3>
              <p class="mt-4">
                社内のコーダーを集め、勉強会を開催しました。各自の知見を共有し、チーム全体のスキルを底上げすることを目的としています。<br />
                また、業務効率化のためにVBAを独学し、実務に活かした経験もあります。与えられた作業をこなすだけでなく、課題を見つけて自分から改善に取り組む姿勢を大切にしています。
              </p>
            </section>
          </div>
        </div>
      </section>
      <section id="section05" class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]">
		<hgroup>
			<p class="section-number text-body mt-[0.5em]">[05]</p>
			<h2 class="text-display section-inset-x mt-[4rem]">アウトプット</h2>
		</hgroup>
        <div class="section-inset-x mt-[4rem]">
          <TextCards items={outputs} label="アウトプット一覧" maxColumns={2} />
        </div>
      </section>
    </main>
    <footer id="site-footer" class="border-t border-gray-900 pt-[8rem] mt-[8rem] dark:border-gray-100">
      <div class="flex flex-col items-start gap-[6rem] sm:flex-row sm:items-start sm:justify-between">
        <p class="text-logo font-zen header_logo">
          タカハシ<br />
          タカユキ<br />
          のポート<br />
          フォリオ
        </p>
        <nav
          aria-label="フッターナビゲーション"
          class="text-body w-fit bg-white text-left font-sans font-light text-gray-900 dark:bg-gray-900 dark:text-gray-100 sm:text-right"
        >
          <ul class="grid gap-2 lg:p-4 pt-0">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div
        class="mt-16 flex items-center justify-end gap-3 text-right font-sans font-light"
      >
        <p class="text-caption">Developed by</p>
        <a
          href="https://github.com/tktkaws"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-6 fill-current"
          >
            <path
              d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0 1 12 7c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.95.68 1.92 0 1.38-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.25C22 6.59 17.52 2 12 2Z"
            ></path>
          </svg>
        </a>
      </div>
    </footer>

  </body>
</html>
