{
  "name": "ttp_002",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumFailingSeverity warning",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "npm run build && html-validate --max-warnings 0 \"dist/**/*.html\"",
    "verify": "npm run check && npm run format:check && npm run build && html-validate --max-warnings 0 \"dist/**/*.html\" && node --experimental-strip-types --test tests/*.test.mjs && playwright test && git diff --check",
    "test:regression": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "matter-js": "^0.20.0",
    "tailwindcss": "^4.3.2",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@tweakpane/core": "^2.0.5",
    "@types/matter-js": "^0.20.2",
    "html-validate": "^11.18.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
